{
  "name": "sluice-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "examples/*", "site"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -p packages/sluice && tsc -p packages/server",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:coverage": "vitest run --coverage",
    "demo": "docker compose --profile demo up --build",
    "bench": "node --expose-gc bench/run.mjs",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:mutation": "stryker run",
    "api:update": "node packages/sluice/scripts/api-report.mjs",
    "api:check": "node packages/sluice/scripts/api-report.mjs --check",
    "docs:build": "npm run build -w sluice-site",
    "docs:dev": "npm run dev -w sluice-site"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@microsoft/api-extractor": "^7.59.4",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^3.23.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
