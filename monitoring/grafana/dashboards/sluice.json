{
  "title": "sluice",
  "uid": "sluice-overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": ["sluice"],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(sluice_pool_capacity, namespace)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(sluice_pool_capacity{namespace=~\"$namespace\"}, target)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sluice_pool_capacity{namespace=~\"$namespace\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connected instances",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sluice_server_sessions)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fleet backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sluice_pool_backlog{namespace=~\"$namespace\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Targets in fallback",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (target) (sluice_fallback_active{namespace=~\"$namespace\"}) == 1) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Capacity vs tokens held",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sluice_pool_capacity{namespace=~\"$namespace\",target=~\"$target\"}",
          "legendFormat": "{{target}} capacity"
        },
        {
          "refId": "B",
          "expr": "sluice_pool_tokens_held{namespace=~\"$namespace\",target=~\"$target\"}",
          "legendFormat": "{{target}} held"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens held by caller",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (caller) (sluice_caller_tokens_held{namespace=~\"$namespace\",target=~\"$target\"})",
          "legendFormat": "{{caller}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backlog (queued items)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (target) (sluice_pool_backlog{namespace=~\"$namespace\",target=~\"$target\"})",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue wait p50 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, target) (rate(sluice_queue_wait_seconds_bucket{namespace=~\"$namespace\",target=~\"$target\"}[1m])))",
          "legendFormat": "{{target}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, target) (rate(sluice_queue_wait_seconds_bucket{namespace=~\"$namespace\",target=~\"$target\"}[1m])))",
          "legendFormat": "{{target}} p99"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Throughput by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (target) (rate(sluice_items_done_total{namespace=~\"$namespace\",target=~\"$target\"}[1m]))",
          "legendFormat": "{{target}} done"
        },
        {
          "refId": "B",
          "expr": "sum by (target) (rate(sluice_items_retried_total{namespace=~\"$namespace\",target=~\"$target\"}[1m]))",
          "legendFormat": "{{target}} retried"
        },
        {
          "refId": "C",
          "expr": "sum by (target) (rate(sluice_items_dead_total{namespace=~\"$namespace\",target=~\"$target\"}[1m]))",
          "legendFormat": "{{target}} dead"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Send duration p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, target) (rate(sluice_send_duration_seconds_bucket{namespace=~\"$namespace\",target=~\"$target\"}[1m])))",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Fallback / circuit open",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (target) (sluice_fallback_active{namespace=~\"$namespace\",target=~\"$target\"})",
          "legendFormat": "{{target}} fallback"
        },
        {
          "refId": "B",
          "expr": "max by (target) (sluice_circuit_open{namespace=~\"$namespace\",target=~\"$target\"})",
          "legendFormat": "{{target}} circuit open"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Waiting instances and debt",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sluice_pool_waiters{namespace=~\"$namespace\",target=~\"$target\"}",
          "legendFormat": "{{target}} waiters"
        },
        {
          "refId": "B",
          "expr": "sluice_pool_debt{namespace=~\"$namespace\",target=~\"$target\"}",
          "legendFormat": "{{target}} debt"
        }
      ]
    }
  ]
}
